{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbr.local/schema/template-capability-v1.schema.json",
  "title": "Renderer Template Capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "formatProfileId", "implementationStatus", "defaultPolicy", "semanticPlacement", "allowedPolicies", "supportsManualCrop", "supportsAgentPlacement"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "formatProfileId": { "type": "string", "minLength": 1 },
    "implementationStatus": { "enum": ["NOT_IMPLEMENTED", "PARTIAL", "IMPLEMENTED"] },
    "defaultPolicy": { "enum": ["ALPHA_TRIM_CONTAIN", "CENTER_CONTAIN", "SEMANTIC_CROP_COVER", "MANUAL_CROP"] },
    "semanticPlacement": { "enum": ["NOT_REQUIRED", "OPTIONAL", "REQUIRED"] },
    "allowedPolicies": { "type": "array", "items": { "enum": ["ALPHA_TRIM_CONTAIN", "CENTER_CONTAIN", "SEMANTIC_CROP_COVER", "MANUAL_CROP"] } },
    "supportsManualCrop": { "type": "boolean" },
    "supportsAgentPlacement": { "type": "boolean" },
    "imageSlotIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
