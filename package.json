{
  "name": "kakao-bizboard-local-renderer",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Unofficial independent local Kakao Bizboard OBJECT_RIGHT renderer core, CLI, and Windows desktop app",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist-desktop/electron-main/main.cjs",
  "bin": {
    "kakao-bizboard-renderer": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "scripts": {
    "verify:contract": "node scripts/verify-contract.mjs",
    "verify:integration-contract": "node scripts/verify-integration-contract.mjs",
    "verify:freeform-contract": "node scripts/verify-freeform-contract.mjs",
    "verify:naver-freeform": "node scripts/verify-naver-freeform-contract.mjs",
    "verify:naver-platform": "node scripts/verify-naver-platform-composed-contract.mjs",
    "verify:handoff": "node scripts/verify-renderer-module-handoff.mjs",
    "verify:naver-contract": "node scripts/verify-naver-smartchannel-contract.mjs",
    "verify:naver-object-placement": "node scripts/verify-naver-smartchannel-object-placement.mjs",
    "verify:naver-font-policy": "node scripts/verify-naver-smartchannel-font-policy.mjs",
    "verify:naver-font-compatibility": "node scripts/verify-naver-smartchannel-font-compatibility.mjs",
    "verify:naver-actual-asset": "node scripts/verify-naver-smartchannel-actual-asset-acceptance.mjs",
    "verify:naver-inventory": "node scripts/verify-naver-smartchannel-n3-inventory.mjs",
    "generate:naver-fixed-components": "node scripts/generate-naver-smartchannel-fixed-component-runtime.mjs",
    "verify:naver-fixed-components": "node scripts/verify-naver-smartchannel-fixed-components.mjs",
    "verify:n7-6-typography": "node scripts/verify-n7-6-smartchannel-typography-audit.mjs",
    "verify:n7-7-font-correction": "node scripts/verify-n7-7-smartchannel-runtime-font-correction.mjs",
    "verify:n7-7-4-ttc": "node scripts/verify-n7-7-4-macos-ttc-integration.mjs",
    "verify:n7-7-5-typography": "node scripts/verify-n7-7-5-typography-parity.mjs",
    "verify:n7-7-6-ui-fields": "node scripts/verify-n7-7-6-smartchannel-text-input-fields.mjs",
    "verify:n7-8-final-baseline": "node scripts/verify-n7-8-smartchannel-final-baseline.mjs",
    "verify:n8-channel": "node scripts/verify-n8-channel-completion.mjs",
    "verify:m0-meta": "node scripts/verify-m0-meta-architecture.mjs",
    "verify:m1-meta": "node scripts/verify-m1-meta-static.mjs",
    "verify:m2-meta": "node scripts/verify-m2-meta-static.mjs",
    "verify:m2-1-meta": "node scripts/verify-m2-1-meta.mjs",
    "verify:m2-2-meta": "node scripts/verify-m2-2-meta.mjs",
    "verify:m2-2a-meta": "node scripts/verify-m2-2a-meta.mjs",
    "verify:m2-3-meta": "node scripts/verify-m2-3-meta-goldens.mjs",
    "verify:g0-google": "node scripts/verify-g0-google-static.mjs",
    "verify:g0-1-google": "node scripts/verify-g0-1-google-architecture-freeze.mjs",
    "verify:g1-google": "node scripts/verify-g1-google-static.mjs",
    "verify:g2-google": "node scripts/verify-g2-google-static.mjs",
    "verify:g2-1-google": "node scripts/verify-g2-1-google-static.mjs",
    "verify:g3-0-1-google": "node scripts/verify-g3-0-1-google-static-desktop-qa.mjs",
    "verify:g3-google": "node scripts/verify-g3-google-static-desktop-qa.mjs",
    "promote:g2-1-google": "node scripts/promote-g2-1-google-goldens.mjs",
    "evidence:m2-meta": "pnpm build && node scripts/generate-m2-meta-audit.mjs",
    "evidence:m2-1-meta": "pnpm build && node scripts/generate-m2-1-meta-candidates.mjs",
    "evidence:m2-2-meta": "pnpm build && node scripts/generate-m2-2-meta-candidates.mjs",
    "evidence:m2-2a-meta": "node scripts/generate-m2-2a-meta-evidence.mjs",
    "evidence:m2-3-meta": "pnpm build && node scripts/generate-m2-3-meta-goldens.mjs",
    "evidence:n8": "node scripts/generate-n8-evidence.mjs",
    "evidence:n7-7-4-ttc": "pnpm build && node scripts/generate-n7-7-4-evidence.mjs",
    "evidence:n7-7-5-typography": "pnpm build && node scripts/generate-n7-7-5-evidence.mjs",
    "evidence:n7-7-6-ui-fields": "pnpm build:desktop && node scripts/generate-n7-7-6-evidence.mjs",
    "evidence:n7-8-final": "pnpm build && node scripts/generate-n7-8-smartchannel-golden-rebase.mjs && node scripts/generate-n7-8-final-evidence.mjs",
    "verify:naver-desktop": "node scripts/verify-naver-desktop-integration.mjs",
    "verify:naver-runtime": "pnpm build && node scripts/verify-naver-smartchannel-runtime.mjs",
    "verify:naver-exhaustive": "pnpm build && node scripts/verify-naver-smartchannel-n3-exhaustive.mjs",
    "extract:naver-source": "python scripts/extract-naver-smartchannel-source.py --source-root \"C:/Users/Lenovo/Desktop/SMARTCHANNEL_GUIDE 12\" --contract-dir contracts --asset-root assets/naver-smartchannel --template-contract contracts/naver-smartchannel-template-contract.json && node scripts/audit-naver-smartchannel-sf-font-layers.mjs && node scripts/generate-naver-smartchannel-runtime-font-policy.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:contract": "tsc -p packages/renderer-contract/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:contract": "tsc -p packages/renderer-contract/tsconfig.json --noEmit",
    "lint": "eslint src apps tests packages/renderer-contract/src",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "pnpm build && vitest run tests/integration",
    "test:integration-contract": "pnpm verify:integration-contract && pnpm build:contract && vitest run tests/integration-contract",
    "test:freeform-contract": "pnpm verify:freeform-contract && pnpm build:contract && vitest run tests/freeform-contract",
    "test:freeform-core": "pnpm build && vitest run tests/freeform-core",
    "test:freeform-validator": "pnpm build && vitest run tests/freeform-validator",
    "test:freeform-presets": "pnpm build && vitest run tests/freeform-presets",
    "test:kakao-freeform-profiles": "pnpm build && vitest run tests/kakao-freeform-profiles",
    "test:jpeg-determinism": "pnpm build && vitest run tests/kakao-freeform-profiles -t JPEG",
    "test:golden": "vitest run tests/golden",
    "test:naver-smartchannel": "pnpm build && pnpm exec vitest run tests/naver-smartchannel",
    "test:security": "vitest run tests/desktop/security",
    "test:desktop": "vitest run tests/desktop",
    "test:e2e": "pnpm build:desktop && playwright test",
    "build:desktop": "pnpm build:contract && pnpm build && node scripts/build-desktop.mjs",
    "desktop:start": "pnpm build:desktop && electron .",
    "package:windows": "pnpm build:desktop && node scripts/package-windows.mjs",
    "smoke:package": "node scripts/smoke-packaged.mjs",
    "smoke:m1-meta": "node scripts/smoke-meta-packaged.mjs",
    "smoke:desktop": "node scripts/smoke-naver-desktop.mjs",
    "smoke:naver-fixed-components": "node scripts/smoke-naver-smartchannel-fixed-components.mjs",
    "evidence:package": "node scripts/capture-packaged-evidence.mjs",
    "check": "pnpm verify:contract && pnpm verify:integration-contract && pnpm verify:freeform-contract && pnpm verify:naver-freeform && pnpm verify:naver-platform && pnpm verify:naver-contract && pnpm verify:naver-object-placement && pnpm verify:naver-font-policy && pnpm verify:naver-font-compatibility && pnpm verify:naver-actual-asset && pnpm verify:naver-inventory && pnpm verify:naver-fixed-components && pnpm verify:n7-7-5-typography && pnpm verify:n7-7-6-ui-fields && pnpm verify:naver-desktop && pnpm verify:n8-channel && pnpm verify:m0-meta && pnpm verify:m1-meta && pnpm verify:m2-meta && pnpm verify:m2-1-meta && pnpm verify:m2-2-meta && pnpm verify:m2-2a-meta && pnpm verify:m2-3-meta && pnpm verify:g0-google && pnpm verify:g0-1-google && pnpm verify:g1-google && pnpm verify:naver-runtime && pnpm verify:naver-exhaustive && pnpm typecheck && pnpm typecheck:contract && pnpm lint && pnpm build:contract && pnpm build && pnpm exec vitest run && pnpm build:desktop && pnpm exec playwright test --retries=1 && pnpm verify:g2-google && pnpm verify:g2-1-google && pnpm verify:g3-google",
    "render": "node dist/cli/index.js"
  },
  "dependencies": {
    "@kbr/renderer-contract": "workspace:1.8.0",
    "@napi-rs/canvas": "1.0.3",
    "ajv": "8.20.0",
    "canonicalize": "3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "local.kbr.desktop.renderer",
    "productName": "Kakao Bizboard Local Renderer - Unofficial",
    "executableName": "Kakao-Bizboard-Local-Renderer",
    "artifactName": "Kakao-Bizboard-Local-Renderer-${version}-${arch}.${ext}",
    "asar": false,
    "compression": "normal",
    "npmRebuild": false,
    "removePackageScripts": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-desktop/**/*",
      "contracts/**/*",
      "packages/renderer-contract/schema/**/*",
      "packages/renderer-contract/dist/**/*",
      "assets/fonts/**/*",
      "assets/masks/**/*",
      "assets/naver-smartchannel/**/*",
      "reference/kakao-tool/OBJECT_RIGHT.png",
      "reference/kakao-tool/THUMBNAIL_BOX_RIGHT.png",
      "reference/kakao-tool/THUMBNAIL_MULTI_RIGHT.png",
      "reference/kakao-tool/MASK_SEMICIRCLE_RIGHT.png",
      "fixtures/valid/object-right__product__basic__pass.png",
      "fixtures/valid/thumbnail-box-right__asset__basic__pass.png",
      "fixtures/valid/thumbnail-box-right__asset__jpeg__pass.jpg",
      "fixtures/valid/jpeg-orientation-1.jpg",
      "fixtures/valid/jpeg-orientation-3.jpg",
      "fixtures/valid/jpeg-orientation-6.jpg",
      "fixtures/valid/jpeg-orientation-8.jpg",
      "fixtures/valid/mask-semicircle-right__image__basic__pass.png",
      "fixtures/valid/mask-semicircle-right__logo__black__pass.png",
      "fixtures/valid/mask-semicircle-right__logo__white__pass.png",
      "fixtures/valid/mask-semicircle-right__logo__colored__pass.png",
      "fixtures/golden/thumbnail-box-right__valid__golden.png",
      "fixtures/golden/thumbnail-multi-right__valid__golden.png",
      "fixtures/golden/mask-semicircle-right__valid__golden.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "optionalDependencies": {
    "@img/sharp-libvips-win32-x64": "1.3.2",
    "@img/sharp-win32-x64": "0.35.3",
    "@napi-rs/canvas-win32-x64-msvc": "1.0.3"
  }
}
