{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbr.local/schema/naver-smartchannel-font-preflight-v1.3.0.schema.json",
  "title": "NAVER SmartChannel collection-aware font preflight v1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["templateContractVersion", "fallbackAllowed", "fontRequirements", "status", "renderStartAllowed", "errors", "warnings"],
  "properties": {
    "templateContractVersion": { "const": "1.10.0" },
    "fallbackAllowed": { "const": false },
    "fontRequirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fontRequirement" }
    },
    "status": { "enum": ["PASS", "BLOCKED"] },
    "renderStartAllowed": { "type": "boolean" },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "fontRequirement": {
      "type": "object",
      "additionalProperties": false,
        "required": ["requiredPostScriptName", "resolutionMode", "fallbackAllowed"],
        "properties": {
          "requiredPostScriptName": { "type": "string", "minLength": 1 },
        "sourcePostScriptName": { "type": "string", "minLength": 1 },
        "runtimePostScriptName": { "type": "string", "minLength": 1 },
        "fontToken": { "type": "string", "pattern": "^NAVER_SC_[A-Z0-9_]+$" },
        "sourceIdentityStatus": { "enum": ["SOURCE_EXACT", "SOURCE_DIFFERENT_BUILD"] },
        "compatibilityStatus": { "enum": ["PSD_EXACT_RENDERER_OWNED", "PROJECT_COMPATIBLE_VERIFIED", "PROJECT_COMPATIBLE_UNVERIFIED", "INCOMPATIBLE"] },
        "resolutionMode": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["BUNDLED_EXACT", "EXTERNAL_EXACT"] }
        },
        "expectedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "expectedVersion": { "type": "string", "minLength": 1 },
        "resourceKind": { "enum": ["SINGLE_FONT", "FONT_COLLECTION", "DERIVED_STANDALONE_FACE"] },
        "collectionFace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "postScriptName"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 },
            "postScriptName": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "fallbackAllowed": { "const": false }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "messageKey", "path"],
      "properties": {
        "code": { "enum": ["NAVER_SMARTCHANNEL_FONT_UNAVAILABLE", "NAVER_SMARTCHANNEL_FONT_IDENTITY_MISMATCH", "NAVER_SMARTCHANNEL_FONT_VERSION_MISMATCH", "FONT_RESOURCE_MISSING", "FONT_RESOURCE_SHA_MISMATCH", "FONT_COLLECTION_FACE_NOT_FOUND", "FONT_COLLECTION_FACE_IDENTITY_MISMATCH", "FONT_COLLECTION_UNSUPPORTED", "FONT_DERIVED_RESOURCE_PROVENANCE_MISMATCH"] },
        "messageKey": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "expected": {},
        "actual": {}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageKey", "path"],
      "properties": {
        "messageKey": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
