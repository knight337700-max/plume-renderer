{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbr.local/schema/naver-smartchannel-font-preflight-v1.0.0.schema.json",
  "title": "NAVER SmartChannel exact font preflight v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["templateContractVersion", "fallbackAllowed", "fontRequirements", "status", "renderStartAllowed", "errors", "warnings"],
  "properties": {
    "templateContractVersion": { "const": "1.9.0" },
    "fallbackAllowed": { "const": false },
    "fontRequirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fontRequirement" }
    },
    "status": { "enum": ["PASS", "BLOCKED"] },
    "renderStartAllowed": { "type": "boolean" },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "fontRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredPostScriptName", "resolutionMode", "fallbackAllowed"],
      "properties": {
        "requiredPostScriptName": { "type": "string", "minLength": 1 },
        "resolutionMode": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["BUNDLED_EXACT", "SYSTEM_EXACT", "EXTERNAL_EXACT"] }
        },
        "expectedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "expectedVersion": { "type": "string", "minLength": 1 },
        "fallbackAllowed": { "const": false }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "messageKey", "path"],
      "properties": {
        "code": { "enum": ["NAVER_SMARTCHANNEL_FONT_UNAVAILABLE", "NAVER_SMARTCHANNEL_FONT_IDENTITY_MISMATCH", "NAVER_SMARTCHANNEL_FONT_VERSION_MISMATCH"] },
        "messageKey": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "expected": {},
        "actual": {}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageKey", "path"],
      "properties": {
        "messageKey": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
