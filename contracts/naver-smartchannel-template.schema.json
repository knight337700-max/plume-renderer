{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbr.local/schema/naver-smartchannel-template-v1.2.0.schema.json",
  "title": "NAVER SmartChannel template contract v1.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryVersion",
    "templateContractVersion",
    "channel",
    "placement",
    "layoutMode",
    "compositionMode",
    "artifactCardinality",
    "runtimeFontPolicyRef",
    "fontResolutionPolicy",
    "canvas",
    "templates"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "$id": {
      "type": "string",
      "minLength": 1
    },
    "registryVersion": {
      "const": "1.2.0"
    },
    "templateContractVersion": {
      "const": "1.9.0"
    },
    "channel": {
      "const": "NAVER_GFA"
    },
    "placement": {
      "const": "SMARTCHANNEL"
    },
    "layoutMode": {
      "const": "TEMPLATE_LOCKED"
    },
    "compositionMode": {
      "const": "RENDERER_COMPOSED"
    },
    "artifactCardinality": {
      "const": "SINGLE"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "heights"
      ],
      "properties": {
        "width": {
          "const": 750
        },
        "heights": {
          "const": [
            160,
            200,
            280
          ]
        },
        "classification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceCatalog": {
      "type": "object",
      "additionalProperties": true
    },
    "identityAxes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "objectKinds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "sides": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affordances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "textVariantWhitelist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "textVariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "variantGenerationPolicy": {
      "type": "string",
      "minLength": 1
    },
    "templateIdPattern": {
      "type": "string",
      "minLength": 1
    },
    "bijection": {
      "type": "object",
      "additionalProperties": true
    },
    "templates": {
      "type": "array",
      "minItems": 120,
      "maxItems": 120,
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": true
    },
    "fixedComponents": {
      "type": "object",
      "additionalProperties": true
    },
    "typographyRegistryRef": {
      "type": "string",
      "minLength": 1
    },
    "n2CandidatesRef": {
      "type": "string",
      "minLength": 1
    },
    "unsupportedCombinationPolicy": {
      "type": "object",
      "additionalProperties": true
    },
    "runtimeBoundary": {
      "type": "object",
      "additionalProperties": true
    },
    "unresolvedBlockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceRevisionRef": {
      "type": "string",
      "minLength": 1
    },
    "psdMetadataRef": {
      "type": "string",
      "minLength": 1
    },
    "fixedComponentsRef": {
      "type": "string",
      "minLength": 1
    },
    "ctaOptionsRef": {
      "type": "string",
      "minLength": 1
    },
    "currentOfficialRuleRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceResolutionStatus": {
      "type": "string",
      "enum": [
        "SOURCE_RESOLVED_WITH_RUNTIME_FONT_BLOCKER"
      ]
    },
    "runtimeFontPolicyRef": {
      "type": "string",
      "minLength": 1
    },
    "fontResolutionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fallbackAllowed",
        "exactIdentityRequired",
        "allowedModes",
        "classification"
      ],
      "properties": {
        "fallbackAllowed": {
          "const": false
        },
        "exactIdentityRequired": {
          "const": true
        },
        "allowedModes": {
          "type": "array",
          "const": [
            "BUNDLED_EXACT",
            "SYSTEM_EXACT",
            "EXTERNAL_EXACT"
          ]
        },
        "classification": {
          "const": "SOURCE_CONFIRMED"
        }
      }
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateId",
        "height",
        "family",
        "objectKind",
        "side",
        "textVariant",
        "affordance",
        "source"
      ],
      "properties": {
        "templateId": {
          "type": "string",
          "pattern": "^NAVER_SMARTCHANNEL_"
        },
        "height": {
          "enum": [
            160,
            200,
            280
          ]
        },
        "family": {
          "enum": [
            "BASIC",
            "EMPHASIS",
            "BOTTOM_DISCLOSURE"
          ]
        },
        "objectKind": {
          "enum": [
            "STANDARD",
            "THUMBNAIL",
            "PERSON_MOVIE"
          ]
        },
        "side": {
          "enum": [
            "LEFT",
            "RIGHT"
          ]
        },
        "textVariant": {
          "type": "string",
          "minLength": 1
        },
        "sourceTextLabel": {
          "type": "string",
          "minLength": 1
        },
        "affordance": {
          "enum": [
            "NONE",
            "LANDING_ICON",
            "APP_CTA"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourcePath",
            "sourceFileName",
            "sha256",
            "canvas",
            "classification"
          ],
          "properties": {
            "sourcePath": {
              "type": "string",
              "minLength": 1
            },
            "sourceFileName": {
              "type": "string",
              "minLength": 1
            },
            "catalogFileName": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "canvas": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "const": 750
                },
                "height": {
                  "enum": [
                    160,
                    200,
                    280
                  ]
                }
              }
            },
            "psdHeader": {
              "type": "object"
            },
            "catalogCrossCheck": {
              "type": "string"
            },
            "classification": {
              "enum": [
                "SOURCE_CONFIRMED",
                "DERIVED_FROM_EXACT_SOURCE_METADATA",
                "UNRESOLVED"
              ]
            },
            "sourceRevisionRef": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sourceMetadataRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "templateId",
            "classification"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "templateId": {
              "type": "string",
              "pattern": "^NAVER_SMARTCHANNEL_"
            },
            "classification": {
              "enum": [
                "SOURCE_CONFIRMED",
                "DERIVED_FROM_EXACT_SOURCE_METADATA",
                "UNRESOLVED"
              ]
            }
          }
        }
      }
    }
  }
}
