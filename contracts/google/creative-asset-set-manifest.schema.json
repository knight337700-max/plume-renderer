{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbr.local/contracts/google/creative-asset-set-manifest.schema.json",
  "title": "Google CreativeAssetSetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilityId", "lifecycleSnapshot", "assets"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "capabilityId": {"type": "string", "minLength": 1},
    "lifecycleSnapshot": {"type": "string", "minLength": 1},
    "brandGuidelinesEnabled": {"type": "boolean"},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "platformFields": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "assetProfileId", "role", "ordinal"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1},
        "assetProfileId": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "mime": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0},
        "hasAlpha": {"type": "boolean"}
      }
    }
  }
}
