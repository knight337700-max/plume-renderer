{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbr.local/schema/naver-smartchannel-object-placement-v1.0.0.schema.json",
  "title": "NAVER SmartChannel object placement contract v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryVersion",
    "status",
    "channel",
    "placement",
    "templateContractVersion",
    "sourceRevisionRef",
    "templateContractRef",
    "coordinateModels",
    "fitModes",
    "anchorModes",
    "clipModes",
    "globalRules",
    "sourceAssetRules",
    "maskGeometry",
    "tokens",
    "templateMappings",
    "sourceAudit",
    "n2Gate"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "$id": { "type": "string", "minLength": 1 },
    "registryVersion": { "const": "1.0.0" },
    "status": { "const": "SOURCE_RESOLVED_PROJECT_CONTRACT" },
    "channel": { "const": "NAVER_GFA" },
    "placement": { "const": "SMARTCHANNEL" },
    "templateContractVersion": { "const": "1.10.0" },
    "sourceRevisionRef": { "type": "string", "minLength": 1 },
    "templateContractRef": { "type": "string", "minLength": 1 },
    "coordinateModels": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
    "fitModes": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "anchorModes": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string" } },
    "clipModes": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "globalRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inheritedKakaoOrFreeformPlacementSemantics",
        "mirrorGeneration",
        "autoTrim",
        "autoCrop",
        "autoResize",
        "autoBackgroundRemoval",
        "semanticFocalCrop",
        "sourceUnknownPolicy"
      ],
      "properties": {
        "inheritedKakaoOrFreeformPlacementSemantics": { "const": false },
        "mirrorGeneration": { "const": "FORBIDDEN" },
        "autoTrim": { "const": "FORBIDDEN" },
        "autoCrop": { "const": "FORBIDDEN" },
        "autoResize": { "const": "FORBIDDEN" },
        "autoBackgroundRemoval": { "const": "FORBIDDEN" },
        "semanticFocalCrop": { "const": "FORBIDDEN" },
        "sourceUnknownPolicy": { "const": "UNRESOLVED_AND_REJECT_RUNTIME_START" }
      }
    },
    "sourceAssetRules": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/sourceAssetRule" }
    },
    "maskGeometry": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/mask" }
    },
    "tokens": {
      "type": "array",
      "minItems": 39,
      "items": { "$ref": "#/$defs/token" }
    },
    "templateMappings": {
      "type": "array",
      "minItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["templateId", "objectPlacementToken", "sourceClassification"],
        "properties": {
          "templateId": { "type": "string", "pattern": "^NAVER_SMARTCHANNEL_" },
          "objectPlacementToken": { "type": "string", "pattern": "^NAVER_SC_" },
          "sourceClassification": { "const": "DERIVED_FROM_EXACT_SOURCE_METADATA" }
        }
      }
    },
    "sourceAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["psdCount", "sourceRevisionRef", "metadataRef", "extractionTool", "auditStatus", "auditedDimensions", "layerStructureSummary", "candidateProof"],
      "properties": {
        "psdCount": { "const": 120 },
        "sourceRevisionRef": { "type": "string", "minLength": 1 },
        "metadataRef": { "type": "string", "minLength": 1 },
        "extractionTool": { "const": "psd-tools==1.18.0" },
        "auditStatus": { "const": "SOURCE_AUDIT_COMPLETE" },
        "auditedDimensions": { "const": [160, 200, 280] },
        "layerStructureSummary": { "type": "object", "required": ["STANDARD", "THUMBNAIL", "PERSON_MOVIE"], "additionalProperties": true },
        "candidateProof": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/candidateProof" } }
      }
    },
    "n2Gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateTemplatesResolved", "unresolvedCandidateCount", "anchor", "fit", "maskClip", "sourceAssetRules", "rendererImplemented", "goldenPngCreated", "desktopUiImplemented", "nextPhase", "ready", "blockers"],
      "properties": {
        "candidateTemplatesResolved": { "const": true },
        "unresolvedCandidateCount": { "const": 0 },
        "anchor": { "const": "FROZEN_SOURCE_DEFINED" },
        "fit": { "const": "FROZEN_SOURCE_BACKED" },
        "maskClip": { "const": "FROZEN_SOURCE_BACKED" },
        "sourceAssetRules": { "const": "FROZEN_OR_NON_BLOCKING_DEFERRED" },
        "rendererImplemented": { "const": false },
        "goldenPngCreated": { "const": false },
        "desktopUiImplemented": { "const": false },
        "nextPhase": { "const": "N2_SMARTCHANNEL_TEMPLATE_ENGINE_REPRESENTATIVE_GOLDENS" },
        "ready": { "const": true },
        "blockers": { "const": [] }
      }
    }
  },
  "$defs": {
    "sourceAssetRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "appliesTo", "coordinateModel", "acceptedMime", "alphaAllowed", "alphaRequired", "dimensionRule", "preprocessing", "trim", "crop", "resize", "background", "maxFileSize", "classification", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^NAVER_SC_" },
        "appliesTo": { "type": "array", "minItems": 1, "items": { "enum": ["STANDARD", "THUMBNAIL", "PERSON_MOVIE"] } },
        "height": { "type": ["integer", "array"] },
        "coordinateModel": { "type": "string" },
        "acceptedMime": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "alphaAllowed": { "type": "boolean" },
        "alphaRequired": { "type": "boolean" },
        "dimensionRule": { "type": "string" },
        "preprocessing": { "const": "NONE" },
        "trim": { "const": "FORBIDDEN" },
        "crop": { "const": "FORBIDDEN" },
        "resize": { "const": "FORBIDDEN" },
        "background": { "type": "string" },
        "maxFileSize": { "type": "string" },
        "classification": { "type": "string", "minLength": 1 },
        "provenance": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maskToken", "mode", "frame", "vectorMaskBboxNormalized", "vectorMaskBboxNormalizedVariants", "pathDigest", "pathDigests", "sourceLayerBounds", "sourceLayerPath", "sourceTemplateIds", "classification"],
      "properties": {
        "maskToken": { "type": "string", "pattern": "^NAVER_SC_MASK_" },
        "mode": { "const": "SOURCE_MASK" },
        "frame": { "$ref": "#/$defs/rect" },
        "vectorMaskBboxNormalized": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
        "vectorMaskBboxNormalizedVariants": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } } },
        "pathDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pathDigests": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "sourceLayerBounds": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer" } },
        "sourceLayerPath": { "type": "string", "minLength": 1 },
        "sourceTemplateIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^NAVER_SMARTCHANNEL_" } },
        "sourceVariantNote": { "type": "string" },
        "classification": { "const": "DERIVED_FROM_EXACT_SOURCE_METADATA" }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "runtimeEnabled", "height", "family", "objectKind", "side", "affordance", "geometrySourceRef", "objectRegionSharedWithAffordanceNone", "sourceAssetRuleId", "sourceAssetRuleRefs", "sourceClassification", "coordinateSpace", "fitMode", "fit", "anchor", "clip", "mask", "autoDesign", "placementFrame", "placementPolicy"],
      "properties": {
        "token": { "type": "string", "pattern": "^NAVER_SC_" },
        "runtimeEnabled": { "const": true },
        "height": { "enum": [160, 200, 280] },
        "family": { "enum": ["BASIC", "EMPHASIS", "BOTTOM_DISCLOSURE"] },
        "objectKind": { "enum": ["STANDARD", "THUMBNAIL", "PERSON_MOVIE"] },
        "side": { "enum": ["LEFT", "RIGHT"] },
        "affordance": { "enum": ["NONE", "LANDING_ICON", "APP_CTA"] },
        "geometrySourceRef": { "type": ["string", "null"] },
        "objectRegionSharedWithAffordanceNone": { "type": "boolean" },
        "sourceAssetRuleId": { "type": "string", "pattern": "^NAVER_SC_" },
        "sourceAssetRuleRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^NAVER_SC_" } },
        "sourceClassification": { "type": "string", "minLength": 1 },
        "coordinateSpace": { "type": "object", "required": ["type"], "additionalProperties": true, "properties": { "type": { "type": "string" } } },
        "fitMode": { "type": "string" },
        "fit": { "type": "object", "required": ["mode"], "additionalProperties": true, "properties": { "mode": { "type": "string" } } },
        "anchor": { "type": "object", "required": ["mode"], "additionalProperties": true, "properties": { "mode": { "type": "string" } } },
        "clip": { "type": "object", "required": ["mode"], "additionalProperties": true, "properties": { "mode": { "type": "string" } } },
        "mask": { "type": "object", "required": ["mode"], "additionalProperties": true, "properties": { "mode": { "type": "string" } } },
        "autoDesign": { "type": "object", "additionalProperties": false, "required": ["trim", "crop", "resize", "backgroundRemoval", "semanticFocalCrop", "padding"], "properties": { "trim": { "const": "FORBIDDEN" }, "crop": { "const": "FORBIDDEN" }, "resize": { "const": "FORBIDDEN" }, "backgroundRemoval": { "const": "FORBIDDEN" }, "semanticFocalCrop": { "const": "FORBIDDEN" }, "padding": { "const": "FORBIDDEN" } } },
        "placementFrame": { "type": ["object", "null"] },
        "placementPolicy": { "type": "string", "minLength": 1 },
        "sourceInput": { "type": "string" },
        "sourceFrame": { "type": "object", "additionalProperties": true }
      }
    },
    "candidateProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "sourceLayerEvidence", "placementToken"],
      "properties": {
        "templateId": { "type": "string", "pattern": "^NAVER_SMARTCHANNEL_" },
        "sourceLayerEvidence": { "type": "object", "additionalProperties": true },
        "placementToken": { "type": "string", "pattern": "^NAVER_SC_" }
      }
    }
  }
}
