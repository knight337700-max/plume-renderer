{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.renderer/contracts/render-manifest-1.0.0.schema.json",
  "title": "Kakao Bizboard Persisted Render Manifest 1.0.0",
  "description": "Persisted as render-manifest.json only after ERROR 0. It intentionally has no digest of itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalInputDigest",
    "normalizedInputDigest",
    "outputPngDigest",
    "templateContractVersion",
    "inputSchemaVersion",
    "outputSchemaVersion",
    "validatorResult",
    "assetDigests",
    "manualAcceptanceStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "canonicalInputDigest": {
      "$ref": "#/$defs/sha256"
    },
    "normalizedInputDigest": {
      "$ref": "#/$defs/sha256"
    },
    "outputPngDigest": {
      "$ref": "#/$defs/sha256"
    },
    "outputArtifactDigest": {
      "$ref": "#/$defs/sha256"
    },
    "outputFileName": {
      "type": "string",
      "minLength": 1
    },
    "outputEncoding": {
      "$ref": "#/$defs/outputEncoding"
    },
    "templateContractVersion": {
      "const": "1.7.0"
    },
    "inputSchemaVersion": {
      "const": "1.2.0"
    },
    "outputSchemaVersion": {
      "const": "2.0.0"
    },
    "validatorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errorCount",
        "warningCount",
        "infoCount",
        "issues"
      ],
      "properties": {
        "errorCount": {
          "const": 0
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0
        },
        "infoCount": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationIssue"
          }
        }
      }
    },
    "assetDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "fonts",
        "approvedIcons",
        "referenceFixture"
      ],
      "properties": {
        "product": {
          "$ref": "#/$defs/assetDigest"
        },
        "fonts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assetDigest"
          }
        },
        "approvedIcons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assetDigest"
          }
        },
        "referenceFixture": {
          "$ref": "#/$defs/assetDigest"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assetDigest"
          }
        },
        "mask": {
          "$ref": "#/$defs/assetDigest"
        }
      }
    },
    "templateId": { "type": "string", "minLength": 1 },
    "formatProfileId": { "type": "string", "minLength": 1 },
    "pixelFingerprint": { "$ref": "#/$defs/sha256" },
    "requestFingerprint": { "$ref": "#/$defs/sha256" },
    "appliedImagePlacements": {
      "type": "array",
      "items": {}
    },
    "appliedElements": {
      "type": "array",
      "items": { "$ref": "#/$defs/freeformAppliedElement" }
    },
    "manualAcceptanceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_REVIEWED",
            "APPROVED",
            "REJECTED",
            "BLOCKED"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "NOT_REVIEWED",
                  "APPROVED",
                  "REJECTED",
                  "BLOCKED"
                ]
              },
              "reviewer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assetDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "freeformAppliedElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elementId", "elementType", "normalizedBounds", "destinationPixelRect", "zIndex", "originalArrayIndex", "opacity"],
      "properties": {
        "elementId": { "type": "string", "minLength": 1 },
        "elementType": { "enum": ["IMAGE", "TEXT", "LOGO"] },
        "normalizedBounds": { "$ref": "#/$defs/normalizedRect" },
        "destinationPixelRect": { "$ref": "#/$defs/pixelRect" },
        "zIndex": { "type": "integer" },
        "originalArrayIndex": { "type": "integer", "minimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "assetDigest": { "$ref": "#/$defs/sha256" },
        "placementPolicy": { "enum": ["ALPHA_TRIM_CONTAIN", "CENTER_CONTAIN", "SEMANTIC_CROP_COVER", "MANUAL_CROP"] },
        "fitMode": { "enum": ["CONTAIN", "COVER"] },
        "requestedCropRect": { "$ref": "#/$defs/normalizedRect" },
        "resolvedSourceCropPixels": { "$ref": "#/$defs/pixelRect" },
        "fontId": { "type": "string", "minLength": 1 },
        "fontAssetDigest": { "$ref": "#/$defs/sha256" },
        "fontSizePx": { "type": "number", "exclusiveMinimum": 0 },
        "lineHeightPx": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
        "wrapMode": { "enum": ["NO_WRAP", "EXPLICIT_NEWLINES", "WORD_WRAP"] },
        "overflowMode": { "enum": ["ERROR", "CLIP"] },
        "overflowDetected": { "type": "boolean" },
        "clipped": { "type": "boolean" }
      }
    },
    "outputEncoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "enum": ["PNG", "JPEG"] },
        "qualityRequested": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "const": "AUTO_FIT" }] },
        "qualityResolved": { "type": "integer", "minimum": 0, "maximum": 100 },
        "chromaSubsampling": { "const": "4:2:0" },
        "progressive": { "const": false },
        "metadataStripped": { "const": true }
      }
    },
    "normalizedRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "pixelRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "path",
        "messageKey"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ]
        },
        "path": {
          "type": "string"
        },
        "messageKey": {
          "type": "string"
        },
        "stage": {
          "enum": ["PRE_RENDER", "POST_RENDER"]
        },
        "imageSlotId": { "type": "string" },
        "slotRole": { "enum": ["IMAGE", "LOGO"] },
        "assetId": { "type": "string" },
        "elementId": { "type": "string" },
        "formatProfileId": { "type": "string" },
        "expected": true,
        "actual": true,
        "bbox": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
